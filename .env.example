# Copy to .env (docker compose reads it automatically) and fill in real values.

# Telegram bot token — used by PocketBase's auth-with-telegram endpoint AND by
# the Next.js webhook bot (app/bot/route.ts). Get it from @BotFather.
BOT_TOKEN=869......:AAFvs.........
NEXT_PUBLIC_POCKETBASE_URL=

# Public HTTPS origin the Mini App is served from. The bot builds the
# "Ilovani ochish" button (<APP_BASE_URL>/seller) and the webhook URL from it.
# No trailing slash. In dev use your ngrok URL.
APP_BASE_URL=https://wordgram.uz

# Optional secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header so the webhook can reject forged requests. Any random string. Use the
# SAME value when registering the webhook: npm run bot:webhook set <url>
TELEGRAM_WEBHOOK_SECRET=

# PocketBase superuser, used by the bot's /seller command to read users.is_seller
# (the users collection isn't publicly readable, so the lookup needs admin auth).
# Create one in the admin UI (http://127.0.0.1:8090/_/) or:
#   docker compose exec backend /pb/yangisi-pb superuser upsert <email> <password>
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
